programa {
  funcao inicio() {
    //entendimento do problema 
     //calcular a quantidade de laranjas vendidas, larnajas inicial - final

    //infos e variaveis
    inteiro inicial , final , vendidas

    //entrada de dados
    escreva("digite a quantidade inicial de laranjas:")
    leia(inicial)
    escreva("digite a quantidade final de laranjas:")
    leia(final)
  
    //processamento
    vendidas= inicial - final

    //saída
    escreva("quantidade de laranjas vendidas:")
    escreva(vendidas)
  }
}
