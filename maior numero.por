programa {
  funcao inicio() {
    inteiro numero1, numero2
    escreva("digite o primeiro numero:")
    leia(numero1)
    escreva("digite o segundo numero:")
    leia(numero2)

    se(numero1 > numero2){
      escreva("esse é o maior numero:" + numero1)
    }
    se(numero1 < numero2){
      escreva("esse é o meior numero:" + numero2)
    }








  }
}
