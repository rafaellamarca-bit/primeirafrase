programa {
  funcao inicio() {
    //entendimento do problema 
    //quanto recebe por dia 5x2,salario * dias

    //infos e dados
    real salario , total
    inteiro dias 

    //entrada de dados
    escreva("digite quantos dias você trabalhou no mês:")
    leia (dias)
    escreva("digite seu salário mensal:")
    leia (salario)

    //processamento
     total = salario / dias

     //saída 
     escreva("o valor dos dias trabalhados:")
     escreva(total)


  }
}
