programa {
  funcao inicio() {
  inteiro dia 
   
   escreva("digite um numero de 1 à 7:")
   leia (dia)

   se( dia == 1){
    escreva("hoje é domingo.")
   }
   se( dia == 2){
    escreva("hoje é segunda.")
   }
   se( dia == 3){
    escreva("foje é terça.")
   }
   se( dia == 4){
    escreva("hoje é quarta.")
   }
   se(dia == 5){
    escreva("hoje é quinta.")
   }
   se( dia == 6){
    escreva("hoje é sexta.")
   } 
   se (dia == 7){
    escreva("hoje é sabádo.")
   }

    
  }
}
