programa {
  funcao inicio() {
    real bomba, unidade, custo 
    inteiro show

    escreva("digite a quantidade de shows:")
   leia (show)
   escreva("digite o preço das bombinhas:")
    leia(unidade)

    custo = show * (7 * unidade )

   escreva(" custo das bombinhas:R$")
   escreva(custo)








  }
}
