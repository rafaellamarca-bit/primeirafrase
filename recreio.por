programa {
  funcao inicio() {
    // entendimeto do problema
    //calcular o horário de  retorno de recreio 

    //infos e varíaveis
    inteiro hora, minuto

    //entrada de dados
    escreva("horário de inicío:")
    leia (hora)
    escreva("minuto de inicío:")
    leia (minuto)

    //processamentos 
    minuto = minuto + 20

    //saída
    escreva("recreio termina:")
    escreva(hora)
    escreva(":")
    escreva(minuto)
   // escreva("o que acontece com quem chega depois do horário?")
  }
}
