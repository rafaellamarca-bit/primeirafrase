programa {
  funcao inicio() {
    //entendimento do problema 
    //preço dos calçados,quantidade e o valeTroca 
  

    //infos e variaveis
    inteiro preco, quantidade, valeTroca

    //entrada de dados
    escreva("digite a quantidade de calçados:")
    leia (quantidade)
    escreva("digite o preço dos sapatos:")
    leia (preco)

    //porecessamento
     valeTroca = quantidade * preco

    //saída 
    escreva ("o total de vale trocas é:")
    escreva(valeTroca)
  }
}
